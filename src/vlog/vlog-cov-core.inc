   "      for (int s = 0; s < __ps_len.size(); s++) begin\n"
   "        int len;\n"
   "        longint tot, np[$];\n"
   "        len = __ps_len[s];\n"
   "        tot = 1;\n"
   "        for (int p = 0; p < len; p++) begin\n"
   "          longint n;\n"
   "          n = 0;\n"
   "          for (int j = __ps_i0[s]; j < __ps_i1[s]; j++)\n"
   "            if (__pi_bit[j] == p) n += longint'(__pi_hi[j] - __pi_lo[j]) + 1;\n"
   "          np.push_back(n);\n"
   "          tot *= n;\n"
   "        end\n"
   "        for (longint c = 0; c < tot; c++) begin\n"
   "          longint r;\n"
   "          id = __cp_nb[cp]++;\n"
   "          __cp_eb[cp] = 1;\n"
   "          __g_n[__g_n.size() - 1]++;\n"
   "          __sq_len.push_back(len); __sq_bn.push_back(id); __sq_g.push_back(__g_cp.size() - 1);\n"
   "          __sq_i0.push_back(__si_lo.size()); __sq_st.push_back(0);\n"
   "          __sq_wt.push_back(0); __sq_tt.push_back(0); __sq_lp.push_back(__ps_lp[s]); __sq_tr.push_back(__ps_tr[s]);\n"
   "          r = c;\n"
   "          for (int p = 0; p < len; p++) begin\n"
   "            longint d;\n"
   "            d = r % np[p];\n"
   "            r = r / np[p];\n"
   "            for (int j = __ps_i0[s]; j < __ps_i1[s]; j++) begin\n"
   "              longint sz;\n"
   "              if (__pi_bit[j] != p) continue;\n"
   "              sz = longint'(__pi_hi[j] - __pi_lo[j]) + 1;\n"
   "              if (d < sz) begin\n"
   "                __v_t v, z;\n"
   "                z = 0;\n"
   "                v = __pi_lo[j] + d;\n"
   "                __si_lo.push_back(v); __si_hi.push_back(v);\n"
   "                __si_mk.push_back(z); __si_bit.push_back(p);\n"
   "                break;\n"
   "              end\n"
   "              d -= sz;\n"
   "            end\n"
   "          end\n"
   "          __sq_i1.push_back(__si_lo.size());\n"
   "        end\n"
   "      end\n"
   "    end\n"
   "    else begin\n"
   "      if (kind == 0) begin\n"
   "        id = __cp_nb[cp]++;\n"
   "        __cp_eb[cp] = 1;\n"
   "        k = id;\n"
   "        __g_n[__g_n.size() - 1] = 1;\n"
   "      end\n"
   "      else if (kind == 2) begin\n"
   "        k = -2 - __ill.size();\n"
   "        __ill.push_back(nm);\n"
   "      end\n"
   "      for (int s = 0; s < __ps_len.size(); s++) begin\n"
   "        __sq_len.push_back(__ps_len[s]); __sq_bn.push_back(k); __sq_g.push_back(__g_cp.size() - 1);\n"
   "        __sq_i0.push_back(__si_lo.size()); __sq_st.push_back(0);\n"
   "        __sq_wt.push_back(0); __sq_tt.push_back(0); __sq_lp.push_back(__ps_lp[s]); __sq_tr.push_back(__ps_tr[s]);\n"
   "        for (int j = __ps_i0[s]; j < __ps_i1[s]; j++) begin\n"
   "          __si_lo.push_back(__pi_lo[j]); __si_hi.push_back(__pi_hi[j]);\n"
   "          __si_mk.push_back(__pi_mk[j]); __si_bit.push_back(__pi_bit[j]);\n"
   "        end\n"
   "        __sq_i1.push_back(__si_lo.size());\n"
   "      end\n"
   "    end\n"
   "    __ps_len.delete(); __ps_i0.delete(); __ps_i1.delete(); __ps_lp.delete(); __ps_tr.delete();\n"
   "    __pi_lo.delete(); __pi_hi.delete(); __pi_mk.delete(); __pi_bit.delete();\n"
   "  endfunction\n"
   "\n"
   "  function void __x_new();\n"
   "    __x_d0.push_back(__xd_cp.size());\n"
   "    __x_d1.push_back(0); __x_m0.push_back(__xm.size());\n"
   "    __x_nb.push_back(0); __x_b0.push_back(0); __xon.push_back(1);\n"
   "  endfunction\n"
   "\n"
   "  function void __xiff(int x, bit c);\n"
   "    __xon[x] = c;\n"
   "  endfunction\n"
   "\n"
   "  function void __xbiff(int x, int j, bit c);\n"
   "    if (__xbm[j] >= 0) __xbok[__x_b0[x] + __xbm[j]] = c;\n"
   "  endfunction\n"
   "\n"
   "  function void __x_dim(int cp);\n"
   "    __xd_cp.push_back(cp);\n"
   "  endfunction\n"
   "\n"
   "  function void __x_begin(int x, string nm);\n"
   "    int p, d0, d1;\n"
   "    @CPO@ o;\n"
   "    p = 1;\n"
   "    d0 = __x_d0[x];\n"
   "    d1 = __xd_cp.size();\n"
   "    __x_d1[x] = d1;\n"
   "    for (int d = d0; d < d1; d++) __xd_st.push_back(0);\n"
   "    for (int d = d1 - 1; d >= d0; d--) begin\n"
   "      __xd_st[d] = p;\n"
   "      p *= __cp_nb[__xd_cp[d]];\n"
   "    end\n"
   "    __x_m0[x] = __xm.size();\n"
   "    for (int t = 0; t < p; t++) __xm.push_back(-3);\n"
   "    __xm_n.push_back(p);\n"
   "    o = new(this, __ncp + x);\n"
   "    o.option.at_least = option.at_least;\n"
   "    o.option.goal = option.goal;\n"
   "    __cpo.push_back(o);\n"
   "    __nx = x + 1;\n"
   "  endfunction\n"
   "\n"
   "  function void __x_coords(int x, int t, ref int c[$]);\n"
   "    int d0, d1;\n"
   "    d0 = __x_d0[x]; d1 = __x_d1[x];\n"
   "    c.delete();\n"
   "    for (int d = d0; d < d1; d++) begin\n"
   "      c.push_back(t / __xd_st[d]);\n"
   "      t = t % __xd_st[d];\n"
   "    end\n"
   "  endfunction\n"
   "\n"
   "  function bit __bo(int c, int g);\n"
   "    return c >= __g_f[g] && c < __g_f[g] + __g_n[g];\n"
   "  endfunction\n"
   "\n"
   "  function void __xset(int id, __v_t lo, __v_t hi);\n"
   "    if (lo > hi) return;\n"
   "    __st_id.push_back(id); __st_lo.push_back(lo); __st_hi.push_back(hi);\n"
   "  endfunction\n"
   "\n"
   "  function bit __boi(int cp, int c, int set);\n"
   "    for (int k = __cp_i0[cp]; k < __cp_i1[cp]; k++) begin\n"
   "      if (__it_bn[k] != c) continue;\n"
   "      for (int j = 0; j < __st_id.size(); j++)\n"
   "        if (__st_id[j] == set && !(__it_hi[k] < __st_lo[j] || __it_lo[k] > __st_hi[j])) return 1;\n"
   "    end\n"
   "    return 0;\n"
   "  endfunction\n"
   "\n"
   "  function void __x_bin(int x, int kind, int sel, string nm);\n"
   "    int p, id, k, m0;\n"
   "    int c[$];\n"
   "    p = __xm_n[x];\n"
   "    m0 = __x_m0[x];\n"
   "    id = -1;\n"
   "    if (kind == 2) begin\n"
   "      k = -2 - __xill.size();\n"
   "      __xill.push_back(nm);\n"
   "    end\n"
   "    for (int t = 0; t < p; t++) begin\n"
   "      __x_coords(x, t, c);\n"
   "      if (!__xp(sel, c)) continue;\n"
   "      if (kind == 0) begin\n"
   "        if (id < 0) id = __x_nb[x]++;\n"
   "        if (__xm[m0 + t] == -3) __xm[m0 + t] = id;\n"
   "      end\n"
   "      else if (kind == 1) __xm[m0 + t] = -1;\n"
   "      else __xm[m0 + t] = k;\n"
   "    end\n"
   "    if (kind == 0) __xbm.push_back(id);\n"
   "  endfunction\n"
   "\n"
   "  function void __x_end(int x);\n"
   "    int p, m0;\n"
   "    p = __xm_n[x];\n"
   "    m0 = __x_m0[x];\n"
   "    for (int t = 0; t < p; t++)\n"
   "      if (__xm[m0 + t] == -3) __xm[m0 + t] = __x_nb[x]++;\n"
   "  endfunction\n"
   "\n"
   "  function void __fin();\n"
   "    int o;\n"
   "    o = 0;\n"
   "    for (int i = 0; i < __ncp; i++) begin\n"
   "      __cp_b0[i] = o;\n"
   "      o += __cp_nb[i];\n"
   "    end\n"
   "    for (int x = 0; x < __nx; x++) begin\n"
   "      __x_b0[x] = o;\n"
   "      o += __x_nb[x];\n"
   "    end\n"
   "    __nb = o;\n"
   "    for (int i = 0; i < __g_cp.size(); i++) __gok.push_back(1);\n"
   "    for (int i = 0; i < o; i++) begin\n"
   "      __cnt.push_back(0); __stamp.push_back(-1); __xstamp.push_back(-1); __hl.push_back(0); __xbok.push_back(1);\n"
   "    end\n"
   "    __mkobjs();\n"
   "    if (__tk < 0) __tk = $__cov_key();\n"
   "    __id = $__cov_new(\"@CGNAME@\", type_option.weight, __tk);\n"
   "    $__cov_set(__id, get_inst_coverage());\n"
   "  endfunction\n"
   "\n"
   "  function void __cp(int i, __v_t v, bit ok);\n"
   "    int b, g, hits;\n"
   "    bit ign;\n"
   "    __hn[i] = 0;\n"
   "    if (!ok || (^v === 1'bx)) return;\n"
   "    __cv[i] = longint'(v);\n"
   "    ign = 0;\n"
   "    for (int k = __cp_x0[i]; k < __cp_x1[i]; k++) begin\n"
   "      if (__gk(__xi_g[k]) && __m(v, __xi_lo[k], __xi_hi[k], __xi_mk[k])) begin\n"
   "        if (__xi_k[k] == -1) ign = 1;\n"
   "        else begin\n"
   "          int q;\n"
   "          q = -2 - __xi_k[k];\n"
   "          $error(\"illegal bin '%s.%s' hit with value %0d\", __iname, __ill[q], v);\n"
   "          return;\n"
   "        end\n"
   "      end\n"
   "    end\n"
   "    if (ign) return;\n"
   "    hits = 0;\n"
   "    for (int k = __cp_i0[i]; k < __cp_i1[i]; k++) begin\n"
   "      if (__gk(__it_g[k]) && __m(v, __it_lo[k], __it_hi[k], __it_mk[k])) begin\n"
   "        b = __it_bn[k];\n"
   "        g = __cp_b0[i] + b;\n"
   "        if (__stamp[g] != __sc) begin\n"
   "          __stamp[g] = __sc;\n"
   "          __cnt[g]++;\n"
   "          if (__cnt[g] == __cpo[i].option.at_least) __dirty = 1;\n"
   "          __hl[__cp_b0[i] + hits] = b;\n"
   "          hits++;\n"
   "        end\n"
   "      end\n"
   "    end\n"
   "    __hn[i] = hits;\n"
   "    if (hits == 0 && __cp_df[i]) __cp_dc[i]++;\n"
   "    if (__cp_t1[i] > __cp_t0[i]) __trans(i, v);\n"
   "  endfunction\n"
   "\n"
   "  function void __trans(int i, __v_t v);\n"
   "    for (int s = __cp_t0[i]; s < __cp_t1[i]; s++) begin\n"
   "      longint sm, m, prev;\n"
   "      sm = 0;\n"
   "      for (int k = __sq_i0[s]; k < __sq_i1[s]; k++)\n"
   "        if (__m(v, __si_lo[k], __si_hi[k], __si_mk[k])) sm |= longint'(1) << __si_bit[k];\n"
   "      prev = ((__sq_st[s] | __sq_tt[s]) << 1) | 1;\n"
   "      m = (prev | (__sq_wt[s] & __sq_lp[s])) & sm;\n"
   "      __sq_wt[s] = (prev | __sq_wt[s]) & __sq_lp[s] & ~sm;\n"
   "      __sq_tt[s] = (__sq_st[s] | __sq_tt[s]) & __sq_tr[s] & ~sm;\n"
   "      __sq_st[s] = m;\n"
   "      if ((m >> (__sq_len[s] - 1)) & 1) begin\n"
   "        int b, g;\n"
   "        b = __sq_bn[s];\n"
   "        if (!__gk(__sq_g[s])) b = -1;\n"
   "        if (b >= 0) begin\n"
   "          g = __cp_b0[i] + b;\n"
   "          if (__stamp[g] != __sc) begin\n"
   "            __stamp[g] = __sc;\n"
   "            __cnt[g]++;\n"
   "            if (__cnt[g] == __cpo[i].option.at_least) __dirty = 1;\n"
   "          end\n"
   "        end\n"
   "        else if (b < -1) begin\n"
   "          int q;\n"
   "          q = -2 - b;\n"
   "          $error(\"illegal transition bin '%s.%s' hit\", __iname, __ill[q]);\n"
   "        end\n"
   "      end\n"
   "    end\n"
   "  endfunction\n"
   "\n"
   "  function void __xs(int x);\n"
   "    int d0, d1, nd, t, m, g, q;\n"
   "    int pos[$];\n"
   "    d0 = __x_d0[x]; d1 = __x_d1[x];\n"
   "    nd = d1 - d0;\n"
   "    if (!__xon[x]) return;\n"
   "    for (int d = d0; d < d1; d++) begin\n"
   "      if (__hn[__xd_cp[d]] == 0) return;\n"
   "      pos.push_back(0);\n"
   "    end\n"
   "    while (1) begin\n"
   "      t = 0;\n"
   "      for (int d = 0; d < nd; d++) begin\n"
   "        int cp;\n"
   "        cp = __xd_cp[d0 + d];\n"
   "        t += __hl[__cp_b0[cp] + pos[d]] * __xd_st[d0 + d];\n"
   "      end\n"
   "      m = __xm[__x_m0[x] + t];\n"
   "      if (m >= 0) begin\n"
   "        g = __x_b0[x] + m;\n"
   "        if (__xbok[g] && __xstamp[g] != __sc) begin\n"
   "          __xstamp[g] = __sc;\n"
   "          __cnt[g]++;\n"
   "          if (__cnt[g] == __cpo[__ncp + x].option.at_least) __dirty = 1;\n"
   "        end\n"
   "      end\n"
   "      else if (m < -1) begin\n"
   "        string s;\n"
   "        q = -2 - m;\n"
   "        s = \"\";\n"
   "        for (int d = 0; d < nd; d++) begin\n"
   "          int cp;\n"
   "          cp = __xd_cp[d0 + d];\n"
   "            s = {s, $sformatf(\"%0d\", __cv[cp]), (d == nd - 1) ? \"\" : \",\"};\n"
   "        end\n"
   "        $error(\"illegal cross bin '%s.%s' hit with values (%s)\", __iname, __xill[q], s);\n"
   "      end\n"
   "      q = nd - 1;\n"
   "      while (q >= 0) begin\n"
   "        pos[q]++;\n"
   "        if (pos[q] < __hn[__xd_cp[d0 + q]]) break;\n"
   "        pos[q] = 0;\n"
   "        q--;\n"
   "      end\n"
   "      if (q < 0) break;\n"
   "    end\n"
   "  endfunction\n"
   "\n"
   "  function void __endsample();\n"
   "    for (int x = 0; x < __nx; x++) __xs(x);\n"
   "    __sc++;\n"
   "    if (__dirty) begin\n"
   "      __dirty = 0;\n"
   "      $__cov_set(__id, get_inst_coverage());\n"
   "    end\n"
   "  endfunction\n"
   "\n"
   "  virtual function real obj_cov_n(int idx, ref int cov, ref int tot);\n"
   "    int n, b0, al, c;\n"
   "    if (idx < __ncp) begin\n"
   "      n = __cp_nb[idx]; b0 = __cp_b0[idx];\n"
   "    end\n"
   "    else begin\n"
   "      n = __x_nb[idx - __ncp]; b0 = __x_b0[idx - __ncp];\n"
   "    end\n"
   "    al = __cpo[idx].option.at_least;\n"
   "    c = 0;\n"
   "    for (int b = 0; b < n; b++) if (__cnt[b0 + b] >= al) c++;\n"
   "    cov = c; tot = n;\n"
   "    if (n == 0) return 0.0;\n"
   "    return 100.0 * real'(c) / real'(n);\n"
   "  endfunction\n"
   "\n"
   "  virtual function real obj_cov(int idx);\n"
   "    int c, t;\n"
   "    return obj_cov_n(idx, c, t);\n"
   "  endfunction\n"
   "\n"
   "  virtual function int __na();\n"
   "    return @NA@;\n"
   "  endfunction\n"
   "\n"
   "  virtual function @CG@ __ai(int i);\n"
   "    return @AI@;\n"
   "  endfunction\n"
   "\n"
   "  virtual function real obj_tcov_n(int idx, ref int cov, ref int tot);\n"
   "    int c, t;\n"
   "    real p;\n"
   "    cov = 0; tot = 0;\n"
   "    for (int i = 0; i < __na(); i++) begin\n"
   "      p = __ai(i).obj_cov_n(idx, c, t);\n"
   "      cov += c; tot += t;\n"
   "    end\n"
   "    return obj_tcov(idx);\n"
   "  endfunction\n"
   "\n"
   "  virtual function real obj_tcov(int idx);\n"
   "    real s;\n"
   "    if (__na() == 0) return 0.0;\n"
   "    s = 0.0;\n"
   "    for (int i = 0; i < __na(); i++) s += __ai(i).obj_cov(idx);\n"
   "    return s / real'(__na());\n"
   "  endfunction\n"
   "\n"
   "  function real get_inst_coverage_n(ref int cov, ref int tot);\n"
   "    real s, ws, w, p;\n"
   "    int c, t;\n"
   "    s = 0.0; ws = 0.0; cov = 0; tot = 0;\n"
   "    for (int i = 0; i < __ncp + __nx; i++) begin\n"
   "      p = obj_cov_n(i, c, t);\n"
   "      if (t == 0) continue;\n"
   "      cov += c; tot += t;\n"
   "      w = __cpo[i].option.weight;\n"
   "      if (w > 0) begin s += w * p; ws += w; end\n"
   "    end\n"
   "    if (ws == 0.0) return 0.0;\n"
   "    return s / ws;\n"
   "  endfunction\n"
   "\n"
   "  function real get_inst_coverage();\n"
   "    int c, t;\n"
   "    return get_inst_coverage_n(c, t);\n"
   "  endfunction\n"
   "\n"
   "@TCOV@\n"
   "  function void start();\n"
   "    __on = 1;\n"
   "  endfunction\n"
   "\n"
   "  function void stop();\n"
   "    __on = 0;\n"
   "  endfunction\n"
   "\n"
   "  function void set_inst_name(string name);\n"
   "    __iname = name;\n"
   "    option.name = name;\n"
   "  endfunction\n"
   "@BODY@\n"
   "endclass\n"
   "\n"
