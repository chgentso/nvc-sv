pkglibexec_SCRIPTS += \
	contrib/functions.sh \
	contrib/install-osvvm.sh \
	contrib/install-osvvm.tcl \
	contrib/install-uvvm.sh \
	contrib/install-vivado.sh \
	contrib/install-quartus.sh \
	contrib/install-ise.sh \
	contrib/install-icecube2.sh \
	contrib/install-libero.sh \
	contrib/install-vunit.sh \
	contrib/install-xpm_vhdl.sh \
	contrib/install-fmf.sh

EXTRA_DIST += $(pkglibexec_SCRIPTS)

if ENABLE_BASH_COMPLETION
bashcompletiondir = $(BASH_COMPLETION_DIR)
bashcompletion_DATA = contrib/nvc-sv.bash

contrib/nvc-sv.bash: contrib/nvc.bash
	$(AM_V_GEN)sed -e 's/for nvc(1)/for nvc-sv(1)/' -e 's/(nvc --list/(nvc-sv --list/' \
	  -e 's/^complete -F _nvc nvc$$/complete -F _nvc nvc-sv/' $(srcdir)/contrib/nvc.bash > $@

EXTRA_DIST += contrib/nvc.bash
CLEANFILES += contrib/nvc-sv.bash
endif
